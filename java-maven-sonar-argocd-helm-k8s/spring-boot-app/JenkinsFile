
pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
            reuseNode true
        }
    }

    environment {
        DOCKER_IMAGE = "chaitanya0004/ultimate-cicd:${BUILD_NUMBER}"
        SONAR_URL = "http://172.31.34.39:9000"
        GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
        GIT_USER_NAME = "kethachaitanya"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/kethachaitanya/Jenkins-Zero-To-Hero.git'

                sh 'echo "Source code checked out successfully"'
            }
        }

        stage('Build and Test') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                        sh '''
                            mvn clean verify \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar \
                              -Dsonar.host.url="$SONAR_URL" \
                              -Dsonar.token="$SONAR_AUTH_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                        sh 'docker build -t "$DOCKER_IMAGE" .'
                    }

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image(env.DOCKER_IMAGE).push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        MANIFEST="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                        git config user.name "K Chaitanya"
                        git config user.email "YOUR_GITHUB_EMAIL"

                        if ! grep -q 'replaceImageTag' "$MANIFEST"; then
                            echo "ERROR: replaceImageTag was not found in $MANIFEST"
                            exit 1
                        fi

                        sed -i "s|replaceImageTag|${BUILD_NUMBER}|g" "$MANIFEST"

                        git add "$MANIFEST"

                        if ! git diff --cached --quiet; then
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                            ASKPASS="$(mktemp)"
                            trap 'rm -f "$ASKPASS"' EXIT

                            cat > "$ASKPASS" <<'ASKPASS_SCRIPT'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\n' "$GIT_USERNAME" ;;
    *Password*) printf '%s\n' "$GITHUB_TOKEN" ;;
    *) exit 1 ;;
esac
ASKPASS_SCRIPT

                            chmod 700 "$ASKPASS"

                            GIT_ASKPASS="$ASKPASS" \
                            GIT_TERMINAL_PROMPT=0 \
                            git push \
                              "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                              HEAD:main
                        else
                            echo "No manifest changes to commit."
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
